# === Connectivity/Hosting ===

NAME=OpenRAC Server

# The address to listen on (0.0.0.0 for every interface) and the port.
HOST=0.0.0.0
PORT=7770
# The launcher's mod sets (short mod codes) over HTTP.
HTTP_PORT=7771

# === Hub and regions ===
# Players reach the hub first (HUB_PORT, TCP), pick a region there, then play on that game server.
# region: a game server that registers with the hub at HUB_ADDRESS. all: a game server that also runs
# the hub it registers with, in one process (a LAN party or one box for a group of friends).
MODE=region
HUB_ADDRESS=hub.openrac.dev:7177
# The region's name in the list, and the address players reach this server on (empty: the address
# the hub sees, or the hub's own when this server is on the hub's machine or network).
REGION_NAME=Local
REGION_HOST=
# Seconds between the heartbeats a server sends the hub.
REGION_REPORT_SECONDS=5

# The hub's own settings (the hub jar, or MODE=all). The key every server must send (empty: any
# server may register), and the silence after which a server is dropped from the list.
HUB_NAME=OpenRAC Hub
HUB_PORT=7177
REGION_KEY=
SERVER_TIMEOUT_SECONDS=20
# Client requests: a burst, then the steady rate per second; over it the hub answers TRY_LATER.
# Logged-in clients get more, as the game asks for its ladders and career right after login.
HUB_REQUEST_BURST=10
HUB_REQUEST_PER_SECOND=2
HUB_ACCOUNT_REQUEST_BURST=40
HUB_ACCOUNT_REQUEST_PER_SECOND=10

# === Accounts and stats (the hub) ===
# PostgreSQL holds the accounts and stats; the hub migrates the schema on start. With DATABASE_URL
# empty, accounts and stats live in memory and are gone when the hub stops.
# Example: DATABASE_URL=jdbc:postgresql://localhost:5432/openrac
DATABASE_URL=
DATABASE_USER=openrac
DATABASE_PASSWORD=
DATABASE_POOL_SIZE=8
# A first login registers its name. Passwords are hashed with bcrypt at this cost (rounds as a
# power of two); a login's session token lasts SESSION_DAYS.
MIN_PASSWORD_LENGTH=4
PASSWORD_COST=10
SESSION_DAYS=30
# Wrong passwords one address may send per window (seconds) before it is told to try later.
LOGIN_FAILURES=10
LOGIN_WINDOW_SECONDS=600
ACCOUNT_THREADS=4

# === Logging ===
# all, verbose, warning, error or none. DEBUGGING=true adds the debug lines (party chat).
DEBUG_LEVEL=all
DEBUGGING=false

# === Parties ===
# Players per party, the host included.
MAX_PARTY_SIZE=4
# Families whose games hold another number of players: family:size, comma separated, up to 24.
# Up Your Arsenal's 8 is what the unmodified game shows; larger rooms need a game that lists more.
FAMILY_PARTY_SIZES=rac3-pal-1:8,rac3-ntsc-1:8
# Characters in a party description, and parties one LIST answer carries.
MAX_DESCRIPTION_LENGTH=48
MAX_LISTED_PARTIES=32
# Bytes of the advert a host may list its party with.
MAX_ADVERT_LENGTH=512

# === Lobby screens ===
# Where the UI descriptions of the games' multiplayer menus are read: <family>.json or <game>.json.
UI_DIRECTORY=ui

# === Mod sets ===
# What a set may weigh compressed and inflated, in bytes.
MODSET_MAX_BODY_BYTES=16384
MODSET_MAX_JSON_BYTES=65536
# Sets kept (past this the one read longest ago goes), and days a set lives after its last read.
MODSET_CAPACITY=50000
MODSET_TTL_DAYS=30
# Where sets are saved so that a restart keeps the codes, and how often, in minutes.
MODSET_FILE=data/modsets.bin
MODSET_SAVE_MINUTES=5
# Per address.
MODSET_PUTS_PER_MINUTE=10
MODSET_GETS_PER_MINUTE=60
# Seconds a request has to arrive whole.
HTTP_TIMEOUT_SECONDS=10

# === Limits ===
# Per connection: a burst, then the steady rate per second. Over it, a packet is dropped.
CHAT_BURST=5
CHAT_PER_SECOND=1
PARTY_BURST=5
PARTY_PER_SECOND=1
DATA_BURST=120
DATA_PER_SECOND=60
RELAY_BURST=240
RELAY_PER_SECOND=120
TIME_BURST=5
TIME_PER_SECOND=2
UI_BURST=5
UI_PER_SECOND=1

# Dropped packets a connection may run up (forgiven per second) before it is closed.
STRIKE_BURST=20
STRIKES_FORGIVEN_PER_SECOND=1

# Open connections one address may hold, and the seconds a connection has to say hello.
MAX_CONNECTIONS_PER_ADDRESS=8
HELLO_TIMEOUT_SECONDS=10

# Seconds without a valid datagram before a session's state goes back to TCP (clients
# send a keepalive every few seconds).
UDP_TIMEOUT_SECONDS=15

# Seconds a dropped player's slot waits for it, and the silence that counts as a drop (clients that
# come back say something every two seconds).
RESUME_SECONDS=120
PARTY_IDLE_SECONDS=5
# Seconds of silence after which a client that promised TIME (HELLO bit 2) is dropped.
KEEP_ALIVE_IDLE_SECONDS=30
# Seconds a party waits for a dropped host before the next in line takes over.
HOST_GRACE_SECONDS=15
